# ==============================================================================
# Everything Market — Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Database Configuration (PostgreSQL 16+)
# Standard connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/everything_market?schema=public&sslmode=prefer"

# Direct URL for migrations and schema updates when using connection poolers (e.g., PgBouncer, Supabase, Neon)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/everything_market?schema=public&sslmode=prefer"

# Application Environment
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Authentication & Session Security (Phase 3)
# Generate a secure 32+ character random secret using: openssl rand -base64 32
AUTH_SECRET="insecure-development-secret-change-in-production-min-32-chars"

# Optional Gemini AI API key (injected at runtime by AI Studio)
GEMINI_API_KEY=""
